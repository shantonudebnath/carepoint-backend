# Backend environment variables
# Local dev (XAMPP): leave DATABASE_URL unset and the app falls back to
# mysql+pymysql://root:@localhost:3306/patientdata

# Production (Railway sets this from the MySQL service reference):
# DATABASE_URL=mysql://user:pass@host:3306/railway

GEMINI_API_KEY=your-google-ai-studio-key

# Optional: where to cache the BioBERT model / NLTK data (set on Railway to the volume)
# HF_HOME=/app/.hf_cache
# NLTK_DATA=/app/.hf_cache/nltk_data
